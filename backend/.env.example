# Copy this file to .env and fill in real values (.env is git-ignored)
GITHUB_TOKEN=
GEMINI_API_KEY=
# Optional, defaults to gemini-3.6-flash
GEMINI_MODEL=
# Optional, used when the main model is overloaded. Defaults to gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=
SUPABASE_URL=
# Must be the service-role (secret) key, not the anon/publishable key
SUPABASE_KEY=

# Optional. Max Gemini-backed actions per UTC day across all users (default 1500); over it, Gemini endpoints return 503
GEMINI_DAILY_CAP=
# Optional. Per-IP limit = per-user limits x this (default 3)
IP_LIMIT_MULTIPLIER=
# Set to 1 when behind a reverse proxy so the client IP comes from X-Forwarded-For
TRUST_PROXY=
